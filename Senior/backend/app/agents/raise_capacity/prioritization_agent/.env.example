# Copy this file to .env and fill in real values. Never commit .env.

# Supabase / PostgreSQL
SUPABASE_URL=
SUPABASE_KEY=

# Gemini
GEMINI_API_KEY=
# Set to the Gemini model you have access to, e.g. gemini-2.5-pro
GEMINI_MODEL=
# Optional. Comma-separated ordered list of additional models to try, in
# order, if GEMINI_MODEL fails with a temporary 503/429 error, e.g.
# GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.0-flash
GEMINI_FALLBACK_MODELS=

# Official UoS website (Phase 2 — exact URL(s) to be confirmed before use)
UOS_STUDY_PLAN_BASE_URL=
