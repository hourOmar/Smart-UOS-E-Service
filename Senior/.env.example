# VITE_API_BASE_URL: Base URL of the future FastAPI backend.
#
# The frontend talks ONLY to this backend — it never accesses
# Supabase, MongoDB, or any LLM provider directly. See
# src/services/api/ for the client that reads this value.
#
# This variable is not yet used at runtime by any page (the app
# currently runs entirely on local mock data — see src/mocks/ and
# each feature's mocks/ folder). It exists so the API client boundary
# has a real, working configuration point ready for Phase 9+.
VITE_API_BASE_URL=http://localhost:8000
